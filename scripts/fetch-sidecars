#!/usr/bin/env bash
set -euo pipefail

# Pinned versions
YTDLP_VERSION="2026.11.23"


# Determine root and binaries dir
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
BIN_DIR="${ROOT_DIR}/src-tauri/binaries"
mkdir -p "${BIN_DIR}"

# Detect target triple
if command -v rustc >/dev/null 2>&1; then
    TARGET_TRIPLE="$(rustc -vV | sed -n 's|host: ||p')"
elif [ -f "$HOME/.cargo/env" ]; then
    source "$HOME/.cargo/env"
    TARGET_TRIPLE="$(rustc -vV | sed -n 's|host: ||p')"
else
    # Fallback detection
    ARCH="$(uname -m)"
    OS="$(uname -s)"
    case "${OS}" in
        Linux*)
            case "${ARCH}" in
                x86_64) TARGET_TRIPLE="x86_64-unknown-linux-gnu" ;;
                aarch64) TARGET_TRIPLE="aarch64-unknown-linux-gnu" ;;
                *) echo "Unsupported Linux arch: ${ARCH}"; exit 1 ;;
            esac
            ;;
        Darwin*)
            case "${ARCH}" in
                x86_64) TARGET_TRIPLE="x86_64-apple-darwin" ;;
                arm64) TARGET_TRIPLE="aarch64-apple-darwin" ;;
                *) echo "Unsupported Darwin arch: ${ARCH}"; exit 1 ;;
            esac
            ;;
        MINGW*|MSYS*|CYGWIN*)
            TARGET_TRIPLE="x86_64-pc-windows-msvc"
            ;;
        *)
            echo "Unknown OS: ${OS}"; exit 1
            ;;
    esac
fi

echo "[INFO] Target triple detected: ${TARGET_TRIPLE}"

EXT=""
if [[ "${TARGET_TRIPLE}" == *"windows"* ]]; then
    EXT=".exe"
fi

YTDLP_DEST="${BIN_DIR}/yt-dlp-${TARGET_TRIPLE}${EXT}"
FFMPEG_DEST="${BIN_DIR}/ffmpeg-${TARGET_TRIPLE}${EXT}"

case "${TARGET_TRIPLE}" in
    x86_64-unknown-linux-gnu) asset=yt-dlp_linux; digest=249ddb058234276bc449b9cd9492aad9f133bda5923c61a9e39983ae114ef17d ;;
    aarch64-unknown-linux-gnu) asset=yt-dlp_linux_aarch64; digest=fb847a2e4a9ddc8cf5fcfb4bb7f42ba8969ecf72068def0278074f9d300bd13c ;;
    *apple-darwin) asset=yt-dlp_macos; digest=57654854886d0398a798895aadf5173e2749fbb5e249b9f3728022ab376e11fb ;;
    x86_64-pc-windows-*) asset=yt-dlp.exe; digest=622ed48023cac1daa52a3bf3a6ac38f03514de214b5f0fa069389fd0f6d17e5c ;;
    *) echo "Unsupported target: ${TARGET_TRIPLE}" >&2; exit 1 ;;
esac

checksum() {
    if command -v sha256sum >/dev/null; then
        sha256sum "$1" | cut -d ' ' -f 1
    else
        shasum -a 256 "$1" | cut -d ' ' -f 1
    fi
}

if [[ ! -f "$YTDLP_DEST" ]] || [[ "$(checksum "$YTDLP_DEST")" != "$digest" ]]; then
    temp="$(mktemp "$BIN_DIR/.yt-dlp.XXXXXXXX")"
    trap 'rm -f "$temp"' EXIT
    curl --fail --location --retry 2 --max-time 180         "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/${asset}" -o "$temp"
    [[ "$(checksum "$temp")" == "$digest" ]] || { echo "yt-dlp checksum mismatch" >&2; exit 1; }
    chmod 755 "$temp"
    mv -f "$temp" "$YTDLP_DEST"
fi

# 2. Fetch or link ffmpeg
if [ -f "${FFMPEG_DEST}" ]; then
    echo "[INFO] ffmpeg sidecar already exists at ${FFMPEG_DEST}"
else
    echo "[INFO] Setting up ffmpeg sidecar..."
    if command -v ffmpeg >/dev/null 2>&1; then
        echo "[INFO] Copying host ffmpeg from $(which ffmpeg) to ${FFMPEG_DEST}"
        cp "$(which ffmpeg)" "${FFMPEG_DEST}"
        chmod +x "${FFMPEG_DEST}"
    else
        echo "[ERR] ffmpeg not found on host. Please install ffmpeg or place ffmpeg-${TARGET_TRIPLE}${EXT} in src-tauri/binaries/."
        exit 1
    fi
fi

echo "[INFO] Sidecars ready:"
ls -lh "${BIN_DIR}"
