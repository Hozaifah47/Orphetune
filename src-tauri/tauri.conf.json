{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-schema/refs/heads/main/tauri.schema.json",
  "productName": "Orphetune",
  "version": "0.1.0",
  "identifier": "com.orphetune.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Orphetune",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost blob: data:; media-src 'self' asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:orphetune.db"]
    }
  }
}
