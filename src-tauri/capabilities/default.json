{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-schema/refs/heads/main/tauri.schema.json",
  "identifier": "default",
  "description": "Default permissions for the app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/yt-dlp", "sidecar": true },
        { "name": "binaries/ffmpeg", "sidecar": true }
      ]
    }
  ]
}
